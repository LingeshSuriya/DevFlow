generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  DEVELOPER
  TESTER
  PENTESTER
  VIEWER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  name         String
  initials     String
  color        String   @default("bg-emerald-500")
  githubId     String?  @unique
  githubLogin  String?
  createdAt    DateTime @default(now())

  memberships    OrgMember[]
  tasks          Task[]
  messages       Message[]
  reportedBugs   Bug[]           @relation("BugReporter")
  assignedBugs   Bug[]           @relation("BugAssignee")
  bugComments    BugComment[]
  pullRequests   PullRequest[]
  reviewComments ReviewComment[]
  activityLogs   ActivityLog[]
  pipelineRuns   PipelineRun[]
}

model Organization {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  githubRepoFullName String? // e.g. "owner/repo" — connects this org to a repo for CI webhooks
  createdAt      DateTime @default(now())

  members      OrgMember[]
  tasks        Task[]
  channels     Channel[]
  bugs         Bug[]
  pullRequests PullRequest[]
  activityLogs ActivityLog[]
  pipelineRuns PipelineRun[]
}

model OrgMember {
  id     String       @id @default(uuid())
  org    Organization @relation(fields: [orgId], references: [id])
  orgId  String
  user   User         @relation(fields: [userId], references: [id])
  userId String
  role   Role         @default(DEVELOPER)

  joinedAt DateTime @default(now())

  @@unique([orgId, userId])
}

model Task {
  id          String       @id @default(uuid())
  org         Organization @relation(fields: [orgId], references: [id])
  orgId       String
  title       String
  description String       @default("")
  status      String       @default("todo")
  points      Int          @default(1)
  assignee    User?        @relation(fields: [assigneeId], references: [id])
  assigneeId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  bugs Bug[]
}

model Channel {
  id        String       @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  name      String
  createdAt DateTime     @default(now())
  messages  Message[]

  @@unique([orgId, name])
}

model Message {
  id        String   @id @default(uuid())
  text      String
  channel   Channel  @relation(fields: [channelId], references: [id])
  channelId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}

model Bug {
  id               String       @id @default(uuid())
  org              Organization @relation(fields: [orgId], references: [id])
  orgId            String
  title            String
  description      String       @default("")
  stepsToReproduce String       @default("")
  severity         String       @default("medium")
  status           String       @default("open")
  reporter         User         @relation("BugReporter", fields: [reporterId], references: [id])
  reporterId       String
  assignee         User?        @relation("BugAssignee", fields: [assigneeId], references: [id])
  assigneeId       String?
  linkedTask       Task?        @relation(fields: [linkedTaskId], references: [id])
  linkedTaskId     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  comments BugComment[]
}

model BugComment {
  id        String   @id @default(uuid())
  bug       Bug      @relation(fields: [bugId], references: [id])
  bugId     String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  text      String
  createdAt DateTime @default(now())
}

model PullRequest {
  id        String       @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  title     String
  sourceUrl String
  diffText  String
  status    String       @default("open")
  author    User         @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime     @default(now())

  comments ReviewComment[]
}

model ReviewComment {
  id         String      @id @default(uuid())
  pr         PullRequest @relation(fields: [prId], references: [id])
  prId       String
  user       User        @relation(fields: [userId], references: [id])
  userId     String
  fileName   String      @default("")
  lineLabel  String      @default("")
  text       String
  isDecision Boolean     @default(false)
  createdAt  DateTime    @default(now())
}

model ActivityLog {
  id           String       @id @default(uuid())
  org          Organization @relation(fields: [orgId], references: [id])
  orgId        String
  actor        User         @relation(fields: [actorId], references: [id])
  actorId      String
  action       String
  resourceType String
  resourceId   String?
  summary      String
  createdAt    DateTime     @default(now())
}

// ---- Module 7: CI/CD Pipeline Monitor (trimmed scope) ----
// Real GitHub webhooks (workflow_run events) drive this — we don't execute CI ourselves,
// that's what GitHub Actions already does. No live raw log tail (needs the Actions API +
// a token) and no Slack/email alerting — see README for what's intentionally left out.
model PipelineRun {
  id               String       @id @default(uuid())
  org              Organization @relation(fields: [orgId], references: [id])
  orgId            String
  externalId       String?      @unique // GitHub's workflow_run.id, for webhook-driven runs
  branch           String
  commitSha        String       @default("")
  commitMessage    String       @default("")
  trigger          String       @default("manual") // push | pull_request | manual | rollback
  status           String       @default("queued")  // queued | running | success | failed
  source           String       @default("manual")  // webhook | manual
  triggeredBy      User?        @relation(fields: [triggeredById], references: [id])
  triggeredById    String?
  rolledBackFromId String?
  createdAt        DateTime     @default(now())
  finishedAt       DateTime?

  steps PipelineStep[]
}

model PipelineStep {
  id       String      @id @default(uuid())
  run      PipelineRun @relation(fields: [runId], references: [id])
  runId    String
  name     String
  status   String      @default("pending") // pending | running | success | failed
  log      String      @default("")
  position Int         @default(0)
}
