DATABASE_URL="postgresql://devflow:devflow@localhost:5433/devflow?schema=public"
PORT=5000
FRONTEND_URL="http://localhost:5173"

JWT_SECRET="change-me-to-a-long-random-string"

# Create a GitHub OAuth App at https://github.com/settings/developers
# Homepage URL:            http://localhost:5173
# Authorization callback:  http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:5000/api/auth/github/callback"

# Optional — verifies GitHub webhook payloads for the CI/CD monitor. Only needed if you
# expose this server publicly (e.g. via ngrok) and configure a real webhook on a repo.
# Without it, /api/webhooks/github still works but skips signature verification.
GITHUB_WEBHOOK_SECRET=""
